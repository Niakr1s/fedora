#!/usr/bin/env bash
#
# toggle-monitor.sh - Toggle a display on/off via cosmic-randr
#
# Usage: toggle-monitor.sh [OUTPUT]
#   OUTPUT: monitor output name. Default: HDMI-A-2

set -euo pipefail

OUTPUT="${1:-HDMI-A-2}"

if ! command -v cosmic-randr >/dev/null 2>&1; then
    echo "Error: 'cosmic-randr' not found in PATH." >&2
    exit 2
fi

if [[ -z "$OUTPUT" ]]; then
    echo "Usage: $0 [OUTPUT]" >&2
    exit 1
fi

# Strip ANSI escape sequences (cosmic-randr colorizes its output)
strip_ansi() { sed -E 's/\x1B\[[0-9;]*[A-Za-z]//g'; }

STATE_LINE="$(cosmic-randr list 2>/dev/null | strip_ansi | grep -E "^${OUTPUT} \(" || true)"

if [[ -z "$STATE_LINE" ]]; then
    echo "Error: output '${OUTPUT}' not found. Available outputs:" >&2
    cosmic-randr list 2>/dev/null | strip_ansi | grep -E '^[A-Za-z].*\(' >&2 || true
    exit 3
fi

if [[ "$STATE_LINE" == *"(enabled)"* ]]; then
    ACTION="disable"
    NEXT="disabled"
elif [[ "$STATE_LINE" == *"(disabled)"* ]]; then
    ACTION="enable"
    NEXT="enabled"
else
    echo "Error: could not parse state for '${OUTPUT}': ${STATE_LINE}" >&2
    exit 4
fi

echo "Output '${OUTPUT}' is currently $([[ "$ACTION" == "disable" ]] && echo enabled || echo disabled); running: cosmic-randr ${ACTION} ${OUTPUT}"

if cosmic-randr "${ACTION}" "${OUTPUT}"; then
    echo "Done. '${OUTPUT}' should now be ${NEXT}."
else
    rc=$?
    echo "Error: 'cosmic-randr ${ACTION} ${OUTPUT}' failed (exit ${rc})." >&2
    exit 4
fi
