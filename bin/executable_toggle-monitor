#!/bin/bash

# Require exactly one argument: the monitor name
if [ $# -ne 1 ]; then
    echo "Usage: $0 <monitor-name>"
    echo "Example: $0 HDMI-A-2"
    echo ""
    echo "Available outputs:"
    kscreen-doctor -j | jq -r '.outputs[].name'
    exit 1
fi

MONITOR="$1"

# Verify the monitor exists
if ! kscreen-doctor -j | jq -e --arg m "$MONITOR" '.outputs[] | select(.name == $m)' > /dev/null; then
    echo "Error: monitor '$MONITOR' not found."
    echo "Available outputs:"
    kscreen-doctor -j | jq -r '.outputs[].name'
    exit 1
fi

# Read current enabled state
STATE=$(kscreen-doctor -j | jq -r --arg m "$MONITOR" '.outputs[] | select(.name == $m) | .enabled')

if [ "$STATE" = "true" ]; then
    kscreen-doctor output."$MONITOR".disable
else
    kscreen-doctor output."$MONITOR".enable
fi
