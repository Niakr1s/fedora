#!/usr/bin/env bash

# Required for glob with nullglob behavior
shopt -s nullglob

if [[ -z "$1" ]]; then
  echo "Usage: $0 <monitor-name>"
  exit 1
fi

MONITOR="$1"

while true; do
  lockfiles=("$XDG_RUNTIME_DIR"/cosmic-greeter-*.lock)

  if ((${#lockfiles[@]} > 0)); then
    echo "watchlock: turning off monitors"
    cosmic-randr disable "$MONITOR"
    wlopm --off "*"
  else
    echo "watchlock: turning off monitors"
    cosmic-randr enable "$MONITOR"
  fi

  sleep 20
done
