#!/usr/bin/env bash

# Usage tips:
# after add new feature don't forget to add it to tasks array

# Define all tasks with their descriptions and commands
# Lines starting with '# ' are section headers and won't be selectable
tasks=(
    "# Core"
    "Enable rpmfusion|enable_rpmfusion"
    "Set groups|set_groups"
    "Install dms-shell (choose niri & kitty)|curl -fsSL https://install.danklinux.com | sh"
    "Install NVIDIA drivers (with CUDA and nvidia-container-toolkit)|install_nvidia"

    "# Software"
    "Install software|install_software"
    "Install podman|install_podman"
    "Install switch emulators|install_switch_emulators"
    "Install playstation emulators|install_playstation_emulators"
    "Install xbox emulators|install_xbox_emulators"
    "Install retroarch|install_retroarch"
    "Install sunshine|install_sunshine"

    "# System"
    "Add essential kernel params|manage_kernel_params"
    "Disable sleep and hibernation|disable_sleep_hybernation"

    "# Tweaks"
    "Link steam runtime to umu|link_steamruntime_to_umu"
    "Enable nvidia-pstated|install_nvidia_pstated"
)

