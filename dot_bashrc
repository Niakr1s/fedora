#
# ~/.bashrc
#

# Source global definitions
if [ -f /etc/bashrc ]; then
    . /etc/bashrc
fi

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias vim='nvim'

alias upd="sudo dnf update && sudo dnf upgrade -y && am -u && flatpak update -y && ~/.local/share/kwin/kdeu"

# Immediately display a list of all options under the command line while cycling
bind 'set show-all-if-ambiguous on'

# Setup CUDA
export LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH
export CUDACXX=/usr/local/cuda/bin/nvcc

PATH_ADDITIONS=(
  "$HOME/.local/bin"
  "$HOME/bin"
  "$HOME/node_modules/.bin"
  "$HOME/go/bin"
  "$HOME/.cargo/bin"
  "$HOME/.asdf/shims"
  "$HOME/.local/share/chezmoi/mgr"
  "$HOME/.local/share/chezmoi/mgr/tools"
  "$HOME/.config/emacs/bin"
)
export PATH="$PATH:$(
  IFS=:
  echo "${PATH_ADDITIONS[*]}"
)"

export EDITOR="nvim"
export VISUAL="nvim"

# Ignore commands that start with spaces and duplicates.
export HISTCONTROL=ignoreboth

# Don't add certain commands to the history file.
export HISTORY_IGNORE="(\&|[bf]g|c|clear|history|exit|q|pwd|* --help)"

# TMUX sessions preload
TMUX_SESSIONS=(
  cz
)

if [ -z "$TMUX" ] && command -v tmuxp &>/dev/null; then
  for SESSION in "${TMUX_SESSIONS[@]}"; do
    tmuxp load "$SESSION" -d &>/dev/null
  done
fi

# tmux aliases
alias txpl="tmuxp ls" # list projects
alias txpa="tmuxp load --yes" # load project
alias txl="tmux ls" # list sessions
alias txa="tmux attach -t" # load session

function y() {
  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
  command yazi "$@" --cwd-file="$tmp"
  IFS= read -r -d '' cwd <"$tmp"
  [ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd"
  command rm -f -- "$tmp"
}

function myip() {
  echo "$(curl -s 2ip.io) (2ip.io)"
  echo "$(curl -s ifconfig.me) (ifconfig.me)"
}

# ALIASES
alias make="make -j$(nproc)"
alias ninja="ninja -j$(nproc)"
alias c="clear"

# Get the error messages from journalctl
alias jctl="journalctl -p 3 -xb"

alias ff="fastfetch"
alias se="sudoedit"

# Opencode (see https://github.com/didvc/opencode-bwrap/blob/master/opencode-bwrap)
function __opencode_bwrap() {
  local WORKSPACES=(
    "$PWD"
  )

  local WORKSPACE_BINDS=()

  echo "workspaces:"
  for ws in "${WORKSPACES[@]}"; do
    if [ -d "$ws" ] && [ "$(realpath -e -- "$ws")" != "$(realpath -e -- "$HOME")" ]; then
      WORKSPACE_BINDS+=(--bind "$ws" "$ws")
      echo "- $ws"
    fi
  done

  bwrap \
    --unshare-all \
    --share-net \
    --unshare-pid \
    --die-with-parent \
    --proc /proc \
    --dev /dev \
    --dev-bind-try /dev/input /dev/input \
    --tmpfs /tmp \
    --tmpfs /run \
    --ro-bind /usr /usr \
    --symlink usr/lib /lib \
    --symlink usr/lib64 /lib64 \
    --symlink usr/bin /bin \
    --symlink usr/sbin /sbin \
    --ro-bind /etc /etc \
    --dir "$HOME" \
    --setenv HOME "$HOME" \
    --setenv PATH "$PATH" \
    --setenv TMPDIR /tmp \
    --bind "$HOME/.local/share/opencode" "$HOME/.local/share/opencode" \
    --bind "$HOME/.config/opencode" "$HOME/.config/opencode" \
    --bind "$HOME/.cache/opencode" "$HOME/.cache/opencode" \
    --bind "$HOME/.local/state/opencode" "$HOME/.local/state/opencode" \
    --ro-bind-try "$HOME/.ssh/known_hosts" "$HOME/.ssh/known_hosts" \
    --ro-bind-try "$HOME/.ssh/config" "$HOME/.ssh/config" \
    --ro-bind-try "$HOME/.ssh/authorized_keys" "$HOME/.ssh/authorized_keys" \
    --ro-bind-try "$HOME/.ssh/id_rsa.pub" "$HOME/.ssh/id_rsa.pub" \
    --ro-bind-try "$HOME/.ssh/id_ed25519.pub" "$HOME/.ssh/id_ed25519.pub" \
    --ro-bind-try "$HOME/.ssh/id_ecdsa.pub" "$HOME/.ssh/id_ecdsa.pub" \
    "${WORKSPACE_BINDS[@]}" \
    opencode --standalone "$@"
}

