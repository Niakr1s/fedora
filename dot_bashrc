# Eza
ezaCmd() {
  eza --group-directories-first --icons --follow-symlinks "$@"
}
ezaCmdTotal() {
  ezaCmd --total-size "$@"
}
alias l="ezaCmd -a"
alias ll="ezaCmd -l"
alias la="ezaCmd -la"
alias llt="ezaCmdTotal -l"
alias lat="ezaCmdTotal -la"

# Fixes for pagers
