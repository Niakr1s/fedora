# FZF config
export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git --exclude dosdevices --exclude drive_c --exclude .venv'
export FZF_CTRL_T_OPTS="--preview 'bat -n --color=always {}' --walker-skip .git,node_modules,target,dosdevices,drive_c,.venv"
export FZF_ALT_C_OPTS="--preview 'tree -C {}' --walker-skip .git,node_modules,target,dosdevices,drive_c,.venv"

# Mount
luksMountUmount() {
  local uuid="$1"
  local label="$2"
  local mountDir="$HOME/drives/$label"

  eval "$(
    cat <<EOF
${label}() {
  sudo mkdir -p "${mountDir}"
  sudo cryptsetup luksOpen /dev/disk/by-uuid/${uuid} "${label}"
  sudo mount /dev/mapper/"${label}" "${mountDir}"
}

${label}u() {
  sudo umount "${mountDir}"
  sudo cryptsetup luksClose "${label}"
}
EOF
  )"
}

