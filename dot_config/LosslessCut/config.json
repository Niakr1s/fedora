		},
		{
			"action": "seekForwards2",
			"keys": "ControlLeft+ShiftLeft+ArrowRight"
		},
		{
			"action": "seekForwardsPercent",
			"keys": "ControlLeft+ArrowRight"
		},
		{
			"action": "seekForwardsPercent",
			"keys": "MetaLeft+ArrowRight"
		},
		{
			"action": "seekForwardsKeyframe",
			"keys": "AltLeft+ArrowRight"
		},
		{
			"action": "jumpCutEnd",
			"keys": "ShiftLeft+ArrowRight"
		},
		{
			"action": "jumpTimelineStart",
			"keys": "ControlLeft+Home"
