		{
			"action": "timelineZoomOut",
			"keys": "ControlLeft+ArrowDown"
		},
		{
			"action": "timelineZoomOut",
			"keys": "MetaLeft+ArrowDown"
		},
		{
			"action": "batchNextFile",
			"keys": "ShiftLeft+ArrowDown"
		},
		{
			"action": "batchOpenNextFile",
			"keys": "ControlLeft+ShiftLeft+ArrowDown"
		},
		{
			"action": "batchOpenSelectedFile",
			"keys": "ShiftLeft+Enter"
		},
		{
			"action": "undo",
			"keys": "ControlLeft+KeyZ"
		},
		{
			"action": "undo",
			"keys": "MetaLeft+KeyZ"
		},
		{
			"action": "redo",
			"keys": "ControlLeft+ShiftLeft+KeyZ"
		},
		{
			"action": "redo",
			"keys": "MetaLeft+ShiftLeft+KeyZ"
		},
		{
			"action": "copySegmentsToClipboard",
			"keys": "ControlLeft+KeyC"
		},
		{
			"action": "copySegmentsToClipboard",
			"keys": "MetaLeft+KeyC"
		},
		{
			"action": "toggleFullscreenVideo",
			"keys": "KeyF"
		},
		{
			"action": "labelCurrentSegment",
			"keys": "Enter"
		},
		{
			"action": "export",
			"keys": "KeyE"
		},
		{
			"action": "toggleKeyboardShortcuts",
			"keys": "ShiftLeft+Slash"
		},
		{
			"action": "increaseVolume",
			"keys": "AltLeft+ArrowUp"
		},
		{
			"action": "decreaseVolume",
			"keys": "AltLeft+ArrowDown"
		},
		{
			"action": "toggleMuted",
			"keys": "KeyM"
		},
		{
			"action": "addSegment",
			"keys": "Equal"
		},
		{
			"action": "splitCurrentSegment",
			"keys": "ArrowDown"
		}
