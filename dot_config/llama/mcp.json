{
  "mcpServers": {
    "searxng": {
      "command": "npx",
      "args": ["-y", "mcp-searxng"],
      "env": { "SEARXNG_URL": "http://searxng.localhost" }
    },
    "time": {
      "command": "uvx",
      "args": [
        "mcp-server-time"
      ]
    },
    "rand": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-rand"
      ]
    },
    "zim": {
      "command": "uvx",
      "args": [
        "openzim-mcp",
        "/home/user/zim"
      ]
    }
  }
}
