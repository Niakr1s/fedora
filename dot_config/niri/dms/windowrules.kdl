// DMS Window Rules - Managed by DankMaterialShell
// Do not edit manually - changes may be overwritten

// @id=wr_1787768287724361691 @name=org.mozilla.firefox
window-rule {
    match app-id="^org.mozilla.firefox$"
    open-maximized true
    open-on-workspace "web"
}

// @id=wr_1787814418960875825 @name=xdg-desktop-portal-gtk
window-rule {
    match app-id="^xdg-desktop-portal-gtk$"
    open-floating true
    max-width 1280
    max-height 720
}

// @id=wr_1787814981139956914 @name=org.keepassxc.KeePassXC
window-rule {
    match app-id="^org.keepassxc.KeePassXC$" title="^KeePassXC - Browser Access Request$"
    open-floating true
}

// @id=wr_1787834625486111832 @name=steam_app_default
window-rule {
    match app-id="^steam_app_default$"
    open-floating false
}
