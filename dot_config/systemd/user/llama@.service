[Unit]
Description=llama.cpp server (Instance %i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Load instance-specific variables (CUDA_VISIBLE_DEVICES, PORT) from a file
# The file path is determined by the instance name (%i)
EnvironmentFile=%h/.config/llama/%i.env

# CUDA_VISIBLE_DEVICES and PORT are now loaded from the EnvironmentFile above
ExecStart=cmpfix-llama-server \
    --jinja \
    --cors-origins "*" \
    --models-preset %h/.config/llama/preset.ini \
    --mcp-servers-config %h/.config/llama/mcp.json \
    --ui-mcp-proxy \
    --tools all \
    --allow-unauthenticated-tools \
    --cache-ram 0 \
    --ctx-checkpoints 0 \
    --load-mode none \
    --parallel 1 \
    --flash-attn on \
    --models-max 1 \
    --host 0.0.0.0 \
    --port ${PORT}

Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT

[Install]
WantedBy=default.target
